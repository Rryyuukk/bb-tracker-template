# ════════════════════════════════════════════════════════════════
# BB-TRACKER · Environment Variables Template
# ════════════════════════════════════════════════════════════════
# Copia este arquivo pra .env.local e preenche com SEUS valores.
# Pra deploy: `vercel env add NOME` (cola valor quando pedir).
# ════════════════════════════════════════════════════════════════


# ──────────────────────────── TIKTOK CAPI ────────────────────────
# Adiciona 1 par PIXEL_ID + ACCESS_TOKEN por produto/mercado.
# <KEY> = nome único da loja (ex: PRODUCT_1_US, MAIN_FUNNEL).
# Get em: TikTok Ads → Tools → Events → Web → Manage → API.

TIKTOK_PRODUCT_1_US_PIXEL_ID=
TIKTOK_PRODUCT_1_US_ACCESS_TOKEN=

# TIKTOK_PRODUCT_1_UK_PIXEL_ID=
# TIKTOK_PRODUCT_1_UK_ACCESS_TOKEN=


# ──────────────────────────── META CAPI ──────────────────────────
# Mesma KEY do TikTok (pra rodar paralelo no mesmo produto).
# Get em: Meta Business → Events Manager → Conversions API.

META_PRODUCT_1_US_PIXEL_ID=
META_PRODUCT_1_US_ACCESS_TOKEN=
# META_PRODUCT_1_US_TEST_CODE=          # opcional, eventos de teste


# ──────────────────────────── SHOPIFY ────────────────────────────
# Mapping JSON: domínio Shopify → KEY (mesmo nome usado acima).
# Pode incluir várias lojas no mesmo JSON.

SHOPIFY_DOMAIN_MAPPING={"sua-loja.myshopify.com":"product_1_us"}
SHOPIFY_PRODUCT_1_US_WEBHOOK_SECRET=


# ──────────────────────────── METADATA POR KEY ────────────────────
# Tudo opcional. Define o nome/categoria que aparece nos eventos.

# BRAND_PRODUCT_1_US=Meu Produto
# CONTENT_PREFIX_PRODUCT_1_US=produto1
# CONTENT_CATEGORY_PRODUCT_1_US=supplement


# ──────────────────────────── PAGE ID → KEY MAPPING ──────────────
# Opcional. Mapa de page_id (do BB_TRACKER_CONFIG) → KEY.
# Útil se page_id != KEY (ex: page_id 'quiz-us', KEY 'product_1_us').

# PAGE_ID_MAPPING={"quiz-us":"product_1_us","quiz-uk":"product_1_uk"}


# ──────────────────────────── POSTHOG (Opcional) ─────────────────
# Só se quiser analytics interno. Tracker funciona sem.

# POSTHOG_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://eu.i.posthog.com
