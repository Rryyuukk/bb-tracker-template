# ════════════════════════════════════════════════════════════════
# BB-TRACKER · Environment Variables Template
# ════════════════════════════════════════════════════════════════
# Copia este arquivo pra .env.local e preenche com SEUS valores.
# Pra deploy: `vercel env add NOME` (cola valor quando pedir).
# ════════════════════════════════════════════════════════════════


# ──────────────────────────── TIKTOK CAPI ────────────────────────
# Adiciona 1 par PIXEL_ID + ACCESS_TOKEN por produto/mercado.
# <KEY> = nome único da loja (ex: PRODUCT_1_US, MAIN_FUNNEL).
# Get em: TikTok Ads → Tools → Events → Web → Manage → API.

TIKTOK_PRODUCT_1_US_PIXEL_ID=
TIKTOK_PRODUCT_1_US_ACCESS_TOKEN=

# TIKTOK_PRODUCT_1_UK_PIXEL_ID=
# TIKTOK_PRODUCT_1_UK_ACCESS_TOKEN=


# ──────────────────────────── META CAPI ──────────────────────────
# Mesma KEY do TikTok (pra rodar paralelo no mesmo produto).
# Get em: Meta Business → Events Manager → Conversions API.

META_PRODUCT_1_US_PIXEL_ID=
META_PRODUCT_1_US_ACCESS_TOKEN=
# META_PRODUCT_1_US_TEST_CODE=          # opcional, eventos de teste


# ──────────────────────────── SHOPIFY ────────────────────────────
# Mapping JSON: domínio Shopify → KEY (mesmo nome usado acima).
# Pode incluir várias lojas no mesmo JSON.

SHOPIFY_DOMAIN_MAPPING={"sua-loja.myshopify.com":"product_1_us"}
SHOPIFY_PRODUCT_1_US_WEBHOOK_SECRET=


# ──────────────────────────── METADATA POR KEY ────────────────────
# Tudo opcional. Define o nome/categoria que aparece nos eventos.

# BRAND_PRODUCT_1_US=Meu Produto
# CONTENT_PREFIX_PRODUCT_1_US=produto1
# CONTENT_CATEGORY_PRODUCT_1_US=supplement


# ──────────────────────────── PAGE ID → KEY MAPPING ──────────────
# Opcional. Mapa de page_id (do BB_TRACKER_CONFIG) → KEY.
# Útil se page_id != KEY (ex: page_id 'quiz-us', KEY 'product_1_us').

# PAGE_ID_MAPPING={"quiz-us":"product_1_us","quiz-uk":"product_1_uk"}


# ──────────────────────────── DASHBOARD (/dashboard) ─────────────
# Public Vercel dashboard with password login + funnel stats + live
# events feed. Reads analytics from PostHog (the tracker already mirrors
# every event to PostHog). Served at https://SEU-bb-tracker.vercel.app/dashboard

# Shared password for the dashboard login (like the reference dashboard).
DASHBOARD_PASSWORD=

# Random string used to sign session cookies (HMAC). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, falls back to DASHBOARD_PASSWORD (changing the password then
# invalidates all active sessions).
SESSION_SECRET=

# PostHog read access for the dashboard queries.
# POSTHOG_API_KEY  = a PERSONAL API key (Settings → Personal API keys) with
#                    "Query Read" scope. NOT the public project (phc_...) key.
# POSTHOG_PROJECT_ID = numeric project id (Settings → Project).
# POSTHOG_API_HOST = the API host (NOT the i.posthog.com ingestion host):
#                    US cloud → https://us.posthog.com
#                    EU cloud → https://eu.posthog.com
POSTHOG_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com


# ──────────────────────────── CHECKOUT CHAMP ────────────────────
# Postback endpoint: /api/checkout-champ  → Meta CAPI + TikTok CAPI + PostHog.
# No HMAC (Checkout Champ doesn't sign), so a shared token authenticates the
# postback — fail-closed (missing/wrong token = rejected).

CHECKOUT_CHAMP_WEBHOOK_SECRET=

# Routing: which product/market KEY (same <KEY> as TIKTOK_<KEY>_* / META_<KEY>_*)
# to use per Checkout Champ campaign. Postback can also send pixel_key directly.
# CHECKOUT_CHAMP_CAMPAIGN_MAPPING={"12345":"product_1_us","67890":"product_1_uk"}

# Fallback KEY when no campaign mapping / pixel_key matches.
# CHECKOUT_CHAMP_DEFAULT_KEY=product_1_us


# ──────────────────────────── POSTHOG SERVER INGEST ──────────────
# Lets server-side events (Shopify + Checkout Champ purchases) show on the
# dashboard. Uses the PostHog *project* write key (phc_...), NOT the personal
# query key above, and the *ingestion* host (*.i.posthog.com).

POSTHOG_PROJECT_API_KEY=
POSTHOG_INGEST_HOST=https://us.i.posthog.com


# ──────────────────────────── POSTHOG INGEST (Opcional) ──────────
# Client-side PostHog (used by bb-tracker.js in the browser). Optional.

# POSTHOG_HOST=https://eu.i.posthog.com
